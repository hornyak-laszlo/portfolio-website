---
import Layout from "@/layouts/main.astro"
import { HeroSection } from "@/components/sections/hero-section"
import { ExperienceSection } from "@/components/sections/experience-section"
import { SkillsSection } from "@/components/sections/skills-section"
import { EducationSection } from "@/components/sections/education-section"
import { LanguagesSection } from "@/components/sections/languages-section"
import { ContactSection } from "@/components/sections/contact-section"
---

<Layout>
  <main id="main-content" class="min-h-screen">
    <HeroSection client:load />
    <ExperienceSection client:load />
    <SkillsSection client:load />
    <EducationSection client:load />
    <LanguagesSection client:load />
    <ContactSection client:load />
  </main>
</Layout>
